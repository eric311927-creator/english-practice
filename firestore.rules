rules_version = '2';

// Each signed-in user can only read and write their own document at /users/{their-uid}.
// No one (not even other signed-in users) can read or write anyone else's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
